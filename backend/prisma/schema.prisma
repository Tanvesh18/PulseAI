generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  EMPLOYEE
  MANAGER
  FINANCE
  HR
  DIRECTOR
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  RESUBMITTED
  APPROVED
  REJECTED
  REOPENED
  VOID
}

model User {
  id String @id
  active Boolean @default(true)
  displayName String
  email String @unique
  employeeId String @unique
  oidcSubject String @unique
  organizationId String
  costCenters String[] @default([])
  role UserRole
  profile EmployeeProfile?
  notifications Notification[]
  auditEvents AuditEvent[]
}

model EmployeeProfile {
  id String @id
  employeeNumber String
  expectedWeeklyHours Int
  organization String
  timezone String
  userId String @unique
  user User @relation(fields: [userId], references: [id])
  assignments Assignment[]
  timesheets Timesheet[]
}

model Assignment {
  id String @id
  employeeId String
  project String
  task String
  employee EmployeeProfile @relation(fields: [employeeId], references: [id])
  @@index([employeeId])
}

model Timesheet {
  id String @id
  employeeId String
  periodStart String
  periodEnd String
  status TimesheetStatus @default(DRAFT)
  version Int @default(1)
  expectedHours Int
  submittedAt String?
  approvedAt String?
  rejectedAt String?
  rejectionReason String?
  reviewerName String?
  entries Json
  revisions Json
  employee EmployeeProfile @relation(fields: [employeeId], references: [id])
  @@unique([employeeId, periodStart])
}

model Notification {
  id String @id
  userId String
  category String
  createdAt String
  href String
  message String
  read Boolean @default(false)
  title String
  user User @relation(fields: [userId], references: [id])
  @@index([userId, createdAt])
}

model AuditEvent {
  id String @id
  action String
  actorUserId String
  createdAt String
  summary String
  targetId String
  actor User @relation(fields: [actorUserId], references: [id])
  @@index([actorUserId, createdAt])
}

model WorkforceEmployee {
  id String @id @default(uuid())
  organizationId String
  code String
  name String
  email String
  businessGroup String
  grade String
  billingGrade String
  costCenter String
  joinDate String
  exitDate String?
  transferDate String?
  previousCostCenter String?
  annualSalary Float @default(0)
  travelFrom String?
  travelTo String?
  usState String?
  category String @default("Employee")
  @@unique([organizationId, code])
}

model BusinessTimesheet {
  id String @id @default(uuid())
  organizationId String
  period String
  businessGroup String
  costCenter String
  managerUserId String
  status TimesheetStatus @default(DRAFT)
  version Int @default(1)
  rows Json
  submittedAt String?
  reviewedAt String?
  reviewerUserId String?
  returnReason String?
  exportedAt String?
  @@unique([organizationId, period, costCenter])
  @@index([organizationId, period, status])
}

model MasterRecord {
  id String @id @default(uuid())
  organizationId String
  kind String
  code String
  data Json
  @@unique([organizationId, kind, code])
}

model HRImport {
  id String @id @default(uuid())
  organizationId String
  period String
  actorUserId String
  filename String
  summary Json
  createdAt DateTime @default(now())
}
