PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=pulseai
SEED_DEMO_DATA=true
JWT_SECRET=replace_this_with_a_long_random_secret
# Approved Director accounts. Each is created automatically on backend startup.
DIRECTOR_1_NAME=
DIRECTOR_1_EMAIL=
DIRECTOR_1_PASSWORD=
DIRECTOR_2_NAME=
DIRECTOR_2_EMAIL=
DIRECTOR_2_PASSWORD=
DIRECTOR_3_NAME=
DIRECTOR_3_EMAIL=
DIRECTOR_3_PASSWORD=
# Optional Manager accounts. The name must exactly match employees.manager_name
# so only that Manager's employee records appear in their review queue.
MANAGER_1_NAME=
MANAGER_1_EMAIL=
MANAGER_1_PASSWORD=
MANAGER_2_NAME=
MANAGER_2_EMAIL=
MANAGER_2_PASSWORD=
MANAGER_3_NAME=
MANAGER_3_EMAIL=
MANAGER_3_PASSWORD=
MANAGER_4_NAME=
MANAGER_4_EMAIL=
MANAGER_4_PASSWORD=
# Create this in Google Cloud Console as a Web application OAuth client.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
