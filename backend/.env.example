PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=pulseai
# Set true for hosted databases such as Aiven that require MySQL TLS; keep false locally.
DB_SSL=false
# Railway MySQL fallbacks. DB_* values take precedence when both are present.
MYSQLHOST=
MYSQLPORT=3306
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=
SEED_DEMO_DATA=true
JWT_SECRET=replace_this_with_a_long_random_secret
# Approved Director accounts. Each is created automatically on backend startup.
DIRECTOR_1_NAME=
DIRECTOR_1_EMAIL=
DIRECTOR_1_PASSWORD=
DIRECTOR_2_NAME=
DIRECTOR_2_EMAIL=
DIRECTOR_2_PASSWORD=
DIRECTOR_3_NAME=
DIRECTOR_3_EMAIL=
DIRECTOR_3_PASSWORD=
# Optional Manager accounts. The name must exactly match employees.manager_name
# so only that Manager's employee records appear in their review queue.
MANAGER_1_NAME=
MANAGER_1_EMAIL=
MANAGER_1_PASSWORD=
MANAGER_2_NAME=
MANAGER_2_EMAIL=
MANAGER_2_PASSWORD=
MANAGER_3_NAME=
MANAGER_3_EMAIL=
MANAGER_3_PASSWORD=
MANAGER_4_NAME=
MANAGER_4_EMAIL=
MANAGER_4_PASSWORD=
# Optional demo Employee account. The email must match an active employee roster record.
EMPLOYEE_1_NAME=
EMPLOYEE_1_EMAIL=
EMPLOYEE_1_PASSWORD=
# Optional Finance accounts. Only configured accounts can access Finance.
FINANCE_1_NAME=
FINANCE_1_EMAIL=
FINANCE_1_PASSWORD=
FINANCE_2_NAME=
FINANCE_2_EMAIL=
FINANCE_2_PASSWORD=
FINANCE_3_NAME=
FINANCE_3_EMAIL=
FINANCE_3_PASSWORD=
# Optional HR accounts. Configure at least one to enable HR sign-in.
HR_1_NAME=
HR_1_EMAIL=
HR_1_PASSWORD=
HR_2_NAME=
HR_2_EMAIL=
HR_2_PASSWORD=
HR_3_NAME=
HR_3_EMAIL=
HR_3_PASSWORD=
# Optional warning threshold. When set (for example 12), Managers see a warning
# for any employee day whose recorded hours exceed this value. Leave blank to disable.
MANAGER_DAILY_HOURS_WARNING_THRESHOLD=
# Create this in Google Cloud Console as a Web application OAuth client.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Create this in GitHub Settings → Developer settings → OAuth Apps.
# Its Authorization callback URL must exactly match GITHUB_CALLBACK_URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
